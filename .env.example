# DeepSeek API 配置
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选：训练目录根路径（默认 ./training_<主题>/）
TRAINING_ROOT=./

# 可选：SQLite 数据库路径（默认 ./data/trainer.db）
DB_PATH=./data/trainer.db

# 可选：Streamlit 服务端口
STREAMLIT_PORT=8501

# 可选：日志级别
LOG_LEVEL=INFO
# 可选：轻语义用途（topic_validation / keyword_generation）路由到的便宜小模型
# 未配置时全部走 DEEPSEEK_MODEL；判分（quiz_grade）不参与路由（一致性护栏）
# LLM_LIGHT_MODEL=qwen-flash
